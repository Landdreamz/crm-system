{
  "name": "crm-system",
  "version": "0.1.0",
  "private": true,
  "description": "CRM dashboard with Land Calculator",
  "scripts": {
    "build": "cd frontend && npm run build",
    "start": "cd frontend && npm start",
    "start:poll": "cd frontend && npm run start:poll",
    "start:serve": "npm run build && npm run serve:build",
    "install:frontend": "cd frontend && rm -rf node_modules package-lock.json && npm install --legacy-peer-deps",
    "serve": "node scripts/serve-local.js",
    "serve:build": "node scripts/serve-build.js",
    "sync:crm": "node scripts/sync-crm-folder.js",
    "build:sync": "npm run build && npm run sync:crm",
    "refresh": "npm run build:sync",
    "deploy": "node scripts/prepare-gh-pages.js && npx gh-pages -d gh-pages-publish -r https://github.com/Landdreamz/crm-system.git",
    "deploy:build": "npm run build && npm run deploy"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}
